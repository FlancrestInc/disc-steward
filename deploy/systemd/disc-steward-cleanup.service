[Unit]
Description=Disc Steward cleanup retry worker
Wants=network-online.target
After=network-online.target
PartOf=disc-steward.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/projects/disc-steward
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/disc-steward/disc-steward.env
ExecStart=%h/projects/disc-steward/.venv/bin/disc-steward cleanup-worker --config %h/projects/disc-steward/config.yaml --poll-interval 60
Restart=always
RestartSec=15
RuntimeDirectory=disc-steward
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/projects/disc-steward /run/disc-steward

[Install]
WantedBy=disc-steward.target
